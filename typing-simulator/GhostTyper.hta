<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>Ghost Typer</title>
<hta:application
  id="ghostTyper"
  applicationname="Ghost Typer"
  caption="yes"
  border="thin"
  scroll="no"
  singleinstance="yes"
  contextmenu="yes"
  selection="yes"
  maximizebutton="no"
  sysmenu="yes" />
<style>
  body {
    font-family: "Segoe UI", Tahoma, sans-serif;
    font-size: 13px;
    background: #f4f4f6;
    color: #1a1a1e;
    margin: 0;
    padding: 14px;
    overflow: hidden;
  }
  h1 { font-size: 17px; margin: 0 0 2px 0; }
  .sub { color: #6a6a72; margin-bottom: 12px; }
  .cols { overflow: hidden; }
  .left { float: left; width: 560px; }
  .right { float: right; width: 330px; }
  textarea {
    width: 552px; height: 330px; padding: 8px;
    font-family: Consolas, "Courier New", monospace; font-size: 13px;
    border: 1px solid #c3c3cc; background: #fff; resize: none;
  }
  .panel { background: #fff; border: 1px solid #c3c3cc; padding: 10px; }
  .row { margin-bottom: 7px; overflow: hidden; }
  .row label { float: left; padding-top: 3px; }
  .row input.num { float: right; width: 62px; padding: 3px; text-align: right;
                   border: 1px solid #c3c3cc; font-family: inherit; font-size: 13px; }
  .hint { color: #85858e; font-size: 11px; margin: -4px 0 8px 0; }
  button {
    font-family: inherit; font-size: 13px; padding: 6px 14px;
    border: 1px solid #b0b0ba; background: #fbfbfd; cursor: pointer;
  }
  button:hover { background: #eef0f6; }
  button[disabled] { color: #a0a0a8; cursor: default; background: #f4f4f6; }
  button.primary { background: #1a5fd0; border-color: #1a5fd0; color: #fff; font-weight: bold; }
  button.primary:hover { background: #1750b0; }
  button.primary[disabled] { background: #b9c6dd; border-color: #b9c6dd; color: #eef; }
  .small { padding: 4px 8px; font-size: 12px; }
  .bar { height: 8px; background: #dcdce4; margin: 10px 0 6px 0; }
  .bar div { height: 8px; width: 0%; background: #1a5fd0; }
  #status { font-weight: bold; }
  #warn { color: #a04000; }
  #overlay {
    display: none; position: absolute; left: 0; top: 0; width: 100%; height: 100%;
    background: #fff;
  }
  #trace {
    font-family: Consolas, "Courier New", monospace; font-size: 12px;
    white-space: pre-wrap; word-wrap: break-word;
    border: 1px solid #c3c3cc; padding: 10px; height: 430px; overflow: auto; background: #fcfcfe;
  }
</style>
</head>
<body>

<h1>Ghost Typer</h1>
<div class="sub">Paste your text, press Start, then click into your Google Doc. Press Esc to stop.</div>

<div class="cols">
  <div class="left">
    <textarea id="script" wrap="soft"></textarea>
    <div class="hint" id="counts">0 characters</div>
  </div>

  <div class="right">
    <div class="panel">
      <div class="row"><label>Speed (words per minute)</label><input class="num" id="wpm" value="62"></div>
      <div class="row"><label>Speed variation (0&ndash;0.8)</label><input class="num" id="wpmVariance" value="0.28"></div>
      <div class="row"><label>Typos per 100 characters</label><input class="num" id="typoRate" value="3.5"></div>
      <div class="row"><label>Countdown before start (s)</label><input class="num" id="startDelay" value="6"></div>
      <div class="row"><label>Pause after each line (s)</label><input class="num" id="linePause" value="0.9"></div>
      <div class="row"><label>Pause after blank line (s)</label><input class="num" id="paragraphPause" value="1.8"></div>
      <div class="row"><label>Thinking pauses per 100 ch</label><input class="num" id="thinkRate" value="1.5"></div>
      <div class="row"><label>Shortest thinking pause (s)</label><input class="num" id="thinkMin" value="0.5"></div>
      <div class="row"><label>Longest thinking pause (s)</label><input class="num" id="thinkMax" value="3"></div>
      <div class="row" style="margin-top:10px">
        <label style="float:none">Presets:</label>
        <button class="small" onclick="applyPreset('careful')">Careful</button>
        <button class="small" onclick="applyPreset('natural')">Natural</button>
        <button class="small" onclick="applyPreset('rushed')">Rushed</button>
      </div>
    </div>
    <div style="margin-top:8px">
      <button class="small" onclick="showPreview()">Preview keystrokes (types nothing)</button>
    </div>
  </div>
</div>

<div style="margin-top:12px">
  <button class="primary" id="btnStart" onclick="startTypingResume()">Start typing</button>
  <button id="btnPause" onclick="togglePause()" disabled>Pause</button>
  <button id="btnStop" onclick="stopTyping()" disabled>Stop</button>
  <span style="float:right; padding-top:6px" id="estimate"></span>
</div>

<div class="bar"><div id="barFill"></div></div>
<div id="status">Ready.</div>
<div id="warn"></div>

<div id="overlay">
  <h1>Keystroke preview</h1>
  <div class="sub" id="previewSummary"></div>
  <div id="trace"></div>
  <div style="margin-top:10px"><button onclick="hidePreview()">Close</button></div>
</div>

<script language="JScript">

// ---- ENGINE START ----  (pure logic; no DOM, no keyboard -- see test_hta_engine.js)

var NEIGHBOURS = {
  "q":"wa","w":"qeas","e":"wrsd","r":"etdf","t":"ryfg","y":"tugh","u":"yihj",
  "i":"uojk","o":"ipkl","p":"ol","a":"qwsz","s":"awedxz","d":"serfcx","f":"drtgvc",
  "g":"ftyhbv","h":"gyujnb","j":"huikmn","k":"jiolm","l":"kop","z":"asx","x":"zsdc",
  "c":"xdfv","v":"cfgb","b":"vghn","n":"bhjm","m":"njk",
  "1":"2q","2":"13w","3":"24e","4":"35r","5":"46t","6":"57y","7":"68u","8":"79i",
  "9":"80o","0":"9p",",":"m.",".":",/","/":".",";":"l'","'":";"
};
var LOWER = "abcdefghijklmnopqrstuvwxyz";
var SENTENCE_END = ".!?";
var CLAUSE_END = ",;:)";

function gauss() {                     // Box-Muller, mean 0 sd 1
  var u = Math.random(), v = Math.random();
  if (u < 1e-12) u = 1e-12;
  return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
}

function pickWeighted(values, weights) {
  var total = 0, k;
  for (k = 0; k < weights.length; k++) { total += weights[k]; }
  var r = Math.random() * total;
  for (k = 0; k < values.length; k++) {
    r -= weights[k];
    if (r <= 0) { return values[k]; }
  }
  return values[values.length - 1];
}

// Straight-quote everything: SendKeys is keyboard-layout based and cannot
// reliably produce curly quotes, en-dashes or ellipses. Google Docs will put
// its own smart quotes back if you leave substitution on.
function normalizeForTyping(s) {
  s = s.replace(/\r\n/g, "\n").replace(/\r/g, "\n");
  s = s.replace(/[\u2018\u2019\u201A\u2032]/g, "'");
  s = s.replace(/[\u201C\u201D\u201E\u2033]/g, '"');
  s = s.replace(/[\u2013\u2014]/g, "--");
  s = s.replace(/\u2026/g, "...");
  s = s.replace(/\u00A0/g, " ");
  s = s.replace(/\t/g, "    ");        // a real Tab would indent the paragraph
  return s;
}

function makeState(text, cfg) {
  return {
    text: text, cfg: cfg,
    i: 0,                 // characters of the script confirmed typed
    drift: 1.0,           // slow random walk in tempo
    sinceTypo: 0,
    typos: 0,
    queue: [],
    outstanding: 0        // wrong characters currently sitting on screen
  };
}

function baseDelay(cfg) {              // milliseconds per character
  return 12000 / Math.max(5, cfg.wpm);
}

function charDelay(st, ch, prev) {
  var cfg = st.cfg;
  var d = baseDelay(cfg) * st.drift;
  var sigma = Math.max(0, Math.min(1, cfg.wpmVariance));
  if (sigma > 0) { d *= Math.exp(gauss() * sigma); }

  if (ch === " ") { d *= 1.15; }
  else if (/[0-9]/.test(ch)) { d *= 1.5; }
  else if (/[A-Z]/.test(ch)) { d *= 1.35; }        // shift key costs time
  else if ("\"'()[]{}@#$%&*_+=<>~`|\\/".indexOf(ch) >= 0) { d *= 1.6; }

  if (prev !== "" && ch === " " && SENTENCE_END.indexOf(prev) >= 0) {
    d += cfg.sentencePause * 1000 * (0.6 + Math.random() * 0.9);
  } else if (prev !== "" && ch === " " && CLAUSE_END.indexOf(prev) >= 0) {
    d += cfg.sentencePause * 1000 * (0.2 + Math.random() * 0.4);
  }

  st.drift += gauss() * 0.02;
  if (st.drift < 0.8) { st.drift = 0.8; }
  if (st.drift > 1.3) { st.drift = 1.3; }

  return Math.max(12, Math.round(d));
}

function slipChar(ch) {
  var neighbours = NEIGHBOURS[ch.toLowerCase()];
  if (!neighbours) { return ch; }
  var wrong = neighbours.charAt(Math.floor(Math.random() * neighbours.length));
  return (ch >= "A" && ch <= "Z") ? wrong.toUpperCase() : wrong;
}

function shouldSlip(st, ch) {
  var cfg = st.cfg;
  if (cfg.typoRate <= 0) { return false; }
  if (st.sinceTypo < cfg.minGap) { return false; }
  if (!/[A-Za-z0-9 ]/.test(ch)) { return false; }
  return Math.random() < cfg.typoRate / 100;
}

// The wrong characters to type at position i. Whatever comes back is typed
// and then fully backspaced, so the document can only end up correct.
function buildMistake(st, i) {
  var text = st.text;
  var ch = text.charAt(i);
  var nxt = (i + 1 < text.length) ? text.charAt(i + 1) : "";

  var kinds = ["substitute", "double", "omit"];
  if (nxt !== "" && nxt !== "\n" && ch !== " " && nxt !== " ") { kinds.push("transpose"); }
  var kind = kinds[Math.floor(Math.random() * kinds.length)];

  var burst, consumed;
  if (kind === "substitute") {
    var wrong = slipChar(ch);
    if (wrong === ch) { wrong = LOWER.charAt(Math.floor(Math.random() * 26)); }
    burst = wrong; consumed = 1;
  } else if (kind === "double") {
    burst = ch + ch; consumed = 1;
  } else if (kind === "transpose") {
    burst = nxt + ch; consumed = 2;
  } else {                                   // fingers ran ahead, letter skipped
    var n = 2 + Math.floor(Math.random() * 3);
    var skipped = text.substring(i + 1, i + 1 + n).split("\n")[0];
    if (skipped === "") { burst = slipChar(ch); consumed = 1; }
    else { burst = skipped; consumed = 1 + skipped.length; }
  }

  // Carry on for a moment before noticing.
  var overshoot = pickWeighted([0,1,2,3,4,5], [28,26,18,12,9,7]);
  if (overshoot > 0) { burst += text.substring(i + consumed, i + consumed + overshoot); }

  burst = burst.split("\n")[0];              // never fake-type across a line break
  if (burst === "") { burst = slipChar(ch); }
  if (burst === "") { burst = "x"; }
  return burst;
}

function queueMistake(st, i) {
  var burst = buildMistake(st, i);
  var prev = (i > 0) ? st.text.charAt(i - 1) : "";
  var k;
  for (k = 0; k < burst.length; k++) {
    var c = burst.charAt(k);
    st.queue.push({ t: "char", ch: c, d: charDelay(st, c, prev), adv: 0, wrong: 1 });
    prev = c;
  }
  st.queue.push({ t: "wait", d: Math.round(180 + Math.random() * 570), adv: 0, wrong: 0 });
  for (k = 0; k < burst.length; k++) {
    st.queue.push({ t: "bs", d: Math.round(50 + Math.random() * 80), adv: 0, wrong: -1 });
  }
  st.queue.push({ t: "wait", d: Math.round(100 + Math.random() * 300), adv: 0, wrong: 0 });
  st.typos++;
  st.sinceTypo = 0;
}

function fillQueue(st) {
  var text = st.text, cfg = st.cfg, i = st.i;
  var ch = text.charAt(i);
  var prev = (i > 0) ? text.charAt(i - 1) : "";

  if (ch === "\n") {
    var blank = (i + 1 < text.length && text.charAt(i + 1) === "\n");
    var pause = blank ? cfg.paragraphPause : cfg.linePause;
    st.queue.push({ t: "enter", d: Math.round(pause * 1000 * (0.7 + Math.random() * 0.7)),
                    adv: 1, wrong: 0 });
    return;
  }

  if (cfg.thinkRate > 0 && prev === " " && Math.random() < cfg.thinkRate / 100) {
    var lo = Math.min(cfg.thinkMin, cfg.thinkMax);
    var hi = Math.max(cfg.thinkMin, cfg.thinkMax);
    st.queue.push({ t: "wait", d: Math.round((lo + Math.random() * (hi - lo)) * 1000),
                    adv: 0, wrong: 0 });
  }

  if (shouldSlip(st, ch)) { queueMistake(st, i); return; }

  st.queue.push({ t: "char", ch: ch, d: charDelay(st, ch, prev), adv: 1, wrong: 0 });
}

// Next keystroke to send, or null when the script is finished.
function nextAction(st) {
  if (st.queue.length === 0) {
    if (st.i >= st.text.length) { return null; }
    fillQueue(st);
  }
  if (st.queue.length === 0) { return null; }
  var a = st.queue.shift();
  if (a.wrong) { st.outstanding += a.wrong; }
  if (a.adv) { st.i += a.adv; st.sinceTypo++; }
  return a;
}

function estimateSeconds(text, cfg) {
  var chars = text.length;
  var newlines = text.split("\n").length - 1;
  var perChar = baseDelay(cfg) / 1000;
  var s = chars * perChar;
  s += newlines * cfg.linePause;
  s += (chars / 100) * cfg.thinkRate * ((cfg.thinkMin + cfg.thinkMax) / 2);
  s += (chars / 100) * cfg.typoRate * (perChar * 6 + 0.6);
  s += cfg.startDelay;
  return s;
}

// ---- ENGINE END ----

var shell = null;
var st = null;
var timer = null;
var running = false;
var paused = false;
var cleaningUp = false;

function $(id) { return document.getElementById(id); }

function num(id, fallback) {
  var v = parseFloat($(id).value);
  if (isNaN(v)) { v = fallback; $(id).value = fallback; }
  return v;
}

function readConfig() {
  return {
    wpm: Math.max(5, num("wpm", 62)),
    wpmVariance: num("wpmVariance", 0.28),
    typoRate: num("typoRate", 3.5),
    startDelay: num("startDelay", 6),
    linePause: num("linePause", 0.9),
    paragraphPause: num("paragraphPause", 1.8),
    thinkRate: num("thinkRate", 1.5),
    thinkMin: num("thinkMin", 0.5),
    thinkMax: num("thinkMax", 3),
    sentencePause: 0.45,
    minGap: 14
  };
}

function applyPreset(name) {
  var p;
  if (name === "careful") {
    p = { wpm: 45, wpmVariance: 0.22, typoRate: 1.2, thinkRate: 2.5, linePause: 1.4, paragraphPause: 2.5 };
  } else if (name === "rushed") {
    p = { wpm: 88, wpmVariance: 0.38, typoRate: 6.5, thinkRate: 0.6, linePause: 0.4, paragraphPause: 0.9 };
  } else {
    p = { wpm: 62, wpmVariance: 0.28, typoRate: 3.5, thinkRate: 1.5, linePause: 0.9, paragraphPause: 1.8 };
  }
  for (var key in p) { if (p.hasOwnProperty(key)) { $(key).value = p[key]; } }
  updateCounts();
}

function formatDuration(seconds) {
  seconds = Math.round(seconds);
  var h = Math.floor(seconds / 3600);
  var m = Math.floor((seconds % 3600) / 60);
  var s = seconds % 60;
  if (h > 0) { return h + "h " + m + "m"; }
  if (m > 0) { return m + "m " + s + "s"; }
  return s + "s";
}

function updateCounts() {
  var text = normalizeForTyping($("script").value);
  $("counts").innerHTML = text.length + " characters";
  if (text.length === 0) { $("estimate").innerHTML = ""; return; }
  $("estimate").innerHTML = "about " + formatDuration(estimateSeconds(text, readConfig())) + " to type";
}

function setStatus(msg) { $("status").innerHTML = msg; }

function updateProgress() {
  var pct = st && st.text.length ? Math.round((st.i / st.text.length) * 100) : 0;
  $("barFill").style.width = pct + "%";
}

// SendKeys treats these as modifiers and grouping; braces make them literal.
function keysFor(ch) {
  if ("+^%~(){}[]".indexOf(ch) >= 0) { return "{" + ch + "}"; }
  return ch;
}

function send(a) {
  if (a.t === "char") { shell.SendKeys(keysFor(a.ch)); }
  else if (a.t === "enter") { shell.SendKeys("{ENTER}"); }
  else if (a.t === "bs") { shell.SendKeys("{BS}"); }
}

function startTyping(resumeAt) {
  if (running) { return; }
  var text = normalizeForTyping($("script").value);
  if (text.replace(/\s/g, "") === "") { alert("Paste the text you want typed first."); return; }

  if (shell === null) {
    try {
      shell = new ActiveXObject("WScript.Shell");
    } catch (e) {
      setStatus("Could not start: Windows Script Host is blocked on this PC.");
      return;
    }
  }

  var nonAscii = text.replace(/[\x20-\x7E\n]/g, "").length;
  $("warn").innerHTML = nonAscii > 0
    ? "Heads up: " + nonAscii + " unusual character(s) may not type correctly."
    : "";

  st = makeState(text, readConfig());
  // Set before any keystroke goes out, so a zero-second countdown cannot type
  // the opening characters twice.
  if (resumeAt > 0 && resumeAt < text.length) { st.i = resumeAt; }
  running = true; paused = false; cleaningUp = false;
  $("btnStart").disabled = true;
  $("btnPause").disabled = false;
  $("btnPause").innerHTML = "Pause";
  $("btnStop").disabled = false;
  updateProgress();
  countdown(Math.round(st.cfg.startDelay));
}

function countdown(remaining) {
  if (!running) { return; }
  if (remaining > 0) {
    setStatus("Starting in " + remaining + "s &mdash; click into your Google Doc now");
    timer = window.setTimeout(function () { countdown(remaining - 1); }, 1000);
    return;
  }
  setStatus("Typing...");
  step();
}

function step() {
  if (!running) { return; }

  if (paused) {
    setStatus("Paused");
    timer = window.setTimeout(step, 200);
    return;
  }

  // Never send keys while this window has focus, or the text lands in here
  // instead of the document.
  if (document.hasFocus && document.hasFocus()) {
    setStatus(cleaningUp
      ? "Click into your document so the last few characters can be erased"
      : "Waiting &mdash; click into your Google Doc");
    timer = window.setTimeout(step, 250);
    return;
  }

  var a = nextAction(st);
  if (a === null) {
    finish(cleaningUp ? "stopped" : "done");
    return;
  }

  send(a);
  updateProgress();
  if (cleaningUp && st.queue.length === 0) {
    finish("stopped");
    return;
  }
  timer = window.setTimeout(step, a.d);
}

function togglePause() {
  if (!running) { return; }
  paused = !paused;
  $("btnPause").innerHTML = paused ? "Resume" : "Pause";
  if (!paused) { setStatus("Typing..."); }
}

// Stopping mid-mistake would leave wrong characters behind, so the queue is
// replaced with just the backspaces needed to undo them.
function stopTyping() {
  if (!running || cleaningUp) { return; }
  paused = false;
  if (st && st.outstanding > 0) {
    cleaningUp = true;
    st.queue = [];
    while (st.outstanding > 0) {
      st.queue.push({ t: "bs", d: 40, adv: 0, wrong: -1 });
      st.outstanding--;
    }
    st.outstanding = st.queue.length;   // decremented again as they are sent
    setStatus("Erasing the half-typed correction...");
  } else {
    finish("stopped");
  }
}

function finish(reason) {
  running = false; paused = false; cleaningUp = false;
  if (timer) { window.clearTimeout(timer); timer = null; }
  $("btnStart").disabled = false;
  $("btnPause").disabled = true;
  $("btnPause").innerHTML = "Pause";
  $("btnStop").disabled = true;
  if (reason === "done") {
    setStatus("Done &mdash; typed " + st.text.length + " characters.");
    $("barFill").style.width = "100%";
  } else {
    setStatus("Stopped at character " + st.i + " of " + st.text.length +
              ". Press Start to carry on from there.");
  }
}

// Restart from where a stopped run left off, rather than from the beginning.
// Only resumes when the script has not been edited since the run stopped.
function startTypingResume() {
  var text = normalizeForTyping($("script").value);
  var resumeAt = 0;
  if (st && !running && st.i > 0 && st.i < st.text.length && st.text === text) {
    resumeAt = st.i;
  }
  startTyping(resumeAt);
}

function showPreview() {
  var text = normalizeForTyping($("script").value).substring(0, 600);
  if (text === "") { alert("Paste some text first."); return; }
  var cfg = readConfig();
  cfg.startDelay = 0;
  var sim = makeState(text, cfg);
  var trace = [], buffer = [], guard = 0;
  while (guard++ < 200000) {
    var a = nextAction(sim);
    if (a === null) { break; }
    if (a.t === "char") { trace.push(a.ch); buffer.push(a.ch); }
    else if (a.t === "enter") { trace.push("\n"); buffer.push("\n"); }
    else if (a.t === "bs") { trace.push("\u232B"); buffer.pop(); }
  }
  var result = buffer.join("");
  $("previewSummary").innerHTML = sim.typos + " mistakes made and corrected. " +
    "&#9003; marks a backspace. Result matches the script: " +
    (result === text ? "yes" : "NO");
  $("trace").innerText = trace.join("");
  $("overlay").style.display = "block";
}

function hidePreview() { $("overlay").style.display = "none"; }

function init() {
  window.resizeTo(960, 720);
  $("script").onkeyup = updateCounts;
  $("script").onchange = updateCounts;
  var ids = ["wpm","wpmVariance","typoRate","startDelay","linePause",
             "paragraphPause","thinkRate","thinkMin","thinkMax"];
  for (var k = 0; k < ids.length; k++) { $(ids[k]).onkeyup = updateCounts; }
  document.onkeydown = function () {
    if (window.event && window.event.keyCode === 27 && running) { stopTyping(); }
  };
  updateCounts();
  $("script").focus();
}

window.onload = init;

</script>
</body>
</html>
